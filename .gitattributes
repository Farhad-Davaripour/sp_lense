* text=auto eol=lf

# These experiment outputs carry raw-file SHA-256 commitments. Preserve their
# generated bytes instead of applying cross-platform newline normalization.
artifacts/gradient_specificity_adaptive/** -text
results/gradient_specificity_adaptive/** -text
artifacts/counterfactual_protected_natural_gradient_development/** -text
results/counterfactual_protected_natural_gradient_development/** -text
artifacts/counterfactual_tangent_shield_development/** -text -diff
results/counterfactual_tangent_shield_development/** -text -diff
artifacts/decision_margin_shield_layer_screen/** -text -diff
results/decision_margin_shield_layer_screen/** -text -diff
artifacts/decision_margin_shield_layer_screen_solver_amendment/** -text -diff
results/decision_margin_shield_layer_screen_solver_amendment/** -text -diff
artifacts/decision_margin_shield_finite_calibration/** -text -diff
results/decision_margin_shield_finite_calibration/** -text -diff

# The interface-equivariant audit preserves raw full-vocabulary tensors. Its
# construction bank is larger than GitHub's ordinary per-file limit.
artifacts/interface_equivariant_exact_head_development/** -text -diff
results/interface_equivariant_exact_head_development/** -text -diff
artifacts/interface_equivariant_exact_head_development/**/*.pt filter=lfs diff=lfs merge=lfs -text
results/interface_equivariant_exact_head_development/**/*.pt filter=lfs diff=lfs merge=lfs -text

# Closed-loop DMS checkpoints and cross-encoding full-vocabulary tensors are
# immutable hash-bound experiment artifacts; large tensors use Git LFS.
artifacts/closed_loop_dms_development/** -text -diff
results/closed_loop_dms_development/** -text -diff
artifacts/closed_loop_dms_development/**/*.pt filter=lfs diff=lfs merge=lfs -text
artifacts/closed_loop_dms_cross_encoding/** -text -diff
results/closed_loop_dms_cross_encoding/** -text -diff
artifacts/closed_loop_dms_cross_encoding/**/*.pt filter=lfs diff=lfs merge=lfs -text
