    "target_encoding": {
      "formula": "one_hot(class)-1/3",
      "intercept": false
    },
    "solver": {
      "objective": "squared_error_plus_lambda_times_squared_frobenius_norm",
      "deterministic_dual_solution": "W=Z.T@solve(Z@Z.T+lambda*I,Y)",
      "prediction_scores": "Z@W",
      "predicted_class": "argmax_in_frozen_class_order",
      "cross_entropy": "natural_log_softmax_cross_entropy_of_prediction_scores"
    },
    "lambda_selection": {
      "grid": [
        0.0001,
        0.001,
        0.01,
        0.1,
        1.0
      ],
      "method": "five_fold_leave_one_discovery_family_out",
      "criterion": "minimum_overall_out_of_fold_case_mean_cross_entropy",
      "tie_tolerance": 1e-12,
      "tie_break": "larger_lambda",
      "refit_after_selection": "all_discovery_case_mean_features"
    },
    "score_definition": {
      "name": "S",
      "formula": "log(3)-mean_cross_entropy",
      "positive_means_better_than_uniform_cross_entropy": true
    },
    "permutation_null": {
