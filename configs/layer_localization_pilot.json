      "transform": "(x-center_vector)/pooled_rms_scalar",
      "same_training_transform_applied_to_case_means_and_each_raw_order": true,
      "validation_statistics_used_in_preprocessing": false,
      "zero_or_nonfinite_pooled_rms_is_error": true
