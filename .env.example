# Copy to .env. Actual credentials stay in the environment or your Databricks profile.
DATABRICKS_HOST=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=bronze
DATABRICKS_VOLUME=artifacts
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_REPO_PATH=/Workspace/Users/<user>/sp_lense
DATABRICKS_TOKEN_VARIABLE=databricks-token
# Local staging and run outputs are outside the checkout. Set these for your machine or Volume.
RESEARCH3_DATA_ROOT=
RESEARCH3_CLASSIFIER_DATA_ROOT=
RESEARCH3_OUTPUT_ROOT=

DATABRICKS_ACCELERATOR=GPU_1xA10
