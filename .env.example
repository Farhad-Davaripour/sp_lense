# Optional repository location when running the installed tools elsewhere.
# Copy to .env and load it with your shell; the CLI does not parse .env itself.
# No credentials or model downloads are needed for cached reproduction.
# SP_LENSE_REPO=C:/path/to/sp_lense

# Optional live Jev gating comparison. Load with your shell; never commit the key.
# TYPESAFE_API_KEY=
