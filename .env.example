# Optional settings for new native experiments; cached reproduction ignores these.
# Copy to .env and load it with your shell/environment manager before running.
# No credentials are required to replay the study.
SP_LENSE_RESULTS_DIR=results
SP_LENSE_DEVICE=cpu
# Hugging Face libraries recognize HF_HOME for downloaded model caches.
HF_HOME=.cache/huggingface
